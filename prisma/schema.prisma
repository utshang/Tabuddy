generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 對應 spec/erm.dbml 的 users：系統使用者，由 Supabase Auth 管理認證。
// id 直接沿用 auth.users.id（uuid），讓 RLS policy 能直接比對 auth.uid()。
model User {
  id    String @id @db.Uuid
  name  String
  email String @unique

  tripMembers   TripMember[]
  expensesPaid  Expense[]
  expenseSplits ExpenseSplit[]

  @@map("users")
}

// 對應 spec/erm.dbml 的 trips：旅程核心實體。
model Trip {
  id          Int    @id @default(autoincrement())
  name        String
  start_date  String
  end_date    String
  invite_token String @unique

  members        TripMember[]
  days           Day[]
  activities     Activity[]
  transports     Transport[]
  expenses       Expense[]
  expense_splits ExpenseSplit[]

  @@map("trips")
}

// 對應 spec/erm.dbml 的 trip_members：旅程與使用者的多對多關聯。
// joined_at 記錄成員加入旅程的時間，作為開支均分尾差的分配順序依據（加入先後順序需可回溯）。
model TripMember {
  trip_id   Int
  user_id   String   @db.Uuid
  role      String
  joined_at DateTime @default(now()) @db.Timestamptz(6)

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([trip_id, user_id])
  @@map("trip_members")
}

// 對應 spec/erm.dbml 的 days：依旅程起迄日自動產生。
model Day {
  id         Int     @id @default(autoincrement())
  trip_id    Int
  date       String
  start_time String?
  order      Int

  trip       Trip       @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("days")
}

// 對應 spec/erm.dbml 的 activities：某一天的一個行程。
model Activity {
  id               Int     @id @default(autoincrement())
  day_id           Int
  trip_id          Int // denormalize 自 day.trip_id，供 Supabase Realtime filter 依 trip 過濾用
  name             String
  google_map_url   String?
  duration_minutes Int
  note             String?
  order            Int

  day       Day        @relation(fields: [day_id], references: [id], onDelete: Cascade)
  trip      Trip       @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  transport Transport?

  @@index([trip_id])
  @@map("activities")
}

// 對應 spec/erm.dbml 的 transports：行程與行程之間的交通時間。
// after_activity_id 的唯一性約束在資料庫層為 DEFERRABLE INITIALLY DEFERRED（見對應 migration），
// 讓調整行程順序時可在同一筆交易內安全交換兩段交通時間的所屬行程。
model Transport {
  id                Int     @id @default(autoincrement())
  after_activity_id Int     @unique
  trip_id           Int // denormalize 自 after_activity.trip_id，供 Supabase Realtime filter 依 trip 過濾用
  hours             Int
  minutes           Int
  mode              String
  icon              String?

  after_activity Activity @relation(fields: [after_activity_id], references: [id], onDelete: Cascade)
  trip           Trip     @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
  @@map("transports")
}

// 對應 spec/erm.dbml 的 expenses：旅程帳本中的一筆開支。
// category_icon 僅適用於自定義類別；預設四類（住宿/吃喝/購物/其他）的圖示由前端內建提供，不寫入此欄位。
model Expense {
  id            Int     @id @default(autoincrement())
  trip_id       Int
  name          String
  amount        Decimal @db.Decimal
  category      String
  category_icon String?
  expense_date  String
  payer_id      String  @db.Uuid
  split_type    String

  trip   Trip           @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  payer  User           @relation(fields: [payer_id], references: [id])
  splits ExpenseSplit[]

  @@map("expenses")
}

// 對應 spec/erm.dbml 的 expense_splits：記錄某筆開支中每位參與者的分攤金額。
model ExpenseSplit {
  id         Int     @id @default(autoincrement())
  expense_id Int
  trip_id    Int // denormalize 自 expense.trip_id，供 Supabase Realtime filter 依 trip 過濾用
  user_id    String  @db.Uuid
  amount     Decimal @db.Decimal

  expense Expense @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  trip    Trip    @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id])

  @@unique([expense_id, user_id])
  @@index([trip_id])
  @@map("expense_splits")
}
