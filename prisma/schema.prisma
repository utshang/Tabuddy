generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 對應 spec/erm.dbml 的 users：系統使用者，由 Supabase Auth 管理認證。
// id 直接沿用 auth.users.id（uuid），讓 RLS policy 能直接比對 auth.uid()。
model User {
  id    String @id @db.Uuid
  name  String
  email String @unique

  tripMembers   TripMember[]
  expensesPaid  Expense[]
  expenseSplits ExpenseSplit[]

  @@map("users")
}

// 對應 spec/erm.dbml 的 trips：旅程核心實體。
model Trip {
  id          Int    @id @default(autoincrement())
  name        String
  start_date  String
  end_date    String
  invite_token String @unique

  members  TripMember[]
  days     Day[]
  expenses Expense[]

  @@map("trips")
}

// 對應 spec/erm.dbml 的 trip_members：旅程與使用者的多對多關聯。
model TripMember {
  trip_id Int
  user_id String @db.Uuid
  role    String

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([trip_id, user_id])
  @@map("trip_members")
}

// 對應 spec/erm.dbml 的 days：依旅程起迄日自動產生。
model Day {
  id         Int     @id @default(autoincrement())
  trip_id    Int
  date       String
  start_time String?
  order      Int

  trip       Trip       @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("days")
}

// 對應 spec/erm.dbml 的 activities：某一天的一個行程。
// 目前僅為編輯旅程的 cascade 刪除規則提供最小資料模型，尚未實作新增/編輯/刪除行程功能。
model Activity {
  id               Int     @id @default(autoincrement())
  day_id           Int
  name             String
  google_map_url   String?
  duration_minutes Int?
  note             String?
  order            Int

  day       Day        @relation(fields: [day_id], references: [id], onDelete: Cascade)
  transport Transport?

  @@map("activities")
}

// 對應 spec/erm.dbml 的 transports：行程與行程之間的交通時間。
model Transport {
  id                Int    @id @default(autoincrement())
  after_activity_id Int    @unique
  hours             Int
  minutes           Int
  mode              String

  after_activity Activity @relation(fields: [after_activity_id], references: [id], onDelete: Cascade)

  @@map("transports")
}

// 對應 spec/erm.dbml 的 expenses：旅程帳本中的一筆開支。
// 目前僅為刪除旅程的 cascade 刪除規則提供最小資料模型，尚未實作新增開支功能。
model Expense {
  id         Int     @id @default(autoincrement())
  trip_id    Int
  name       String
  amount     Decimal @db.Decimal
  category   String
  payer_id   String  @db.Uuid
  split_type String

  trip   Trip           @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  payer  User           @relation(fields: [payer_id], references: [id])
  splits ExpenseSplit[]

  @@map("expenses")
}

// 對應 spec/erm.dbml 的 expense_splits：記錄某筆開支中每位參與者的分攤金額。
model ExpenseSplit {
  id         Int     @id @default(autoincrement())
  expense_id Int
  user_id    String  @db.Uuid
  amount     Decimal @db.Decimal

  expense Expense @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id])

  @@unique([expense_id, user_id])
  @@map("expense_splits")
}
